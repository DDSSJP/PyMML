;@MML_TYPE,standard,0,utf_8

#Macro {
    STT ; id
    _VNO_  int  0
    _ID_   id   none
    {
        uCHIP,SET_TONE_TABLE,_VNO_,_ID_
    }
}
#Macro {
    WTT ; id
    _TONE_NUM_  int  1
    {
        uCHIP,WRITE_TONE_TABLE,_TONE_NUM_
    }
}
#Macro {
    WCR ; id
    _PARAM_   id    VoVol
    _VALUE_   int   0
    {
        uCHIP,WRITE_CONTROL_REGISTER,_PARAM_,_VALUE_
    }
}
#Macro {
    WEQ ; id
    _BAND_    int   0   ; 0 1 2
    _COEF0_   real  0.0 ; -8.0 < coef < 8.0
    _COEF1_   real  0.0
    _COEF2_   real  0.0
    _COEF3_   real  0.0
    _COEF4_   real  0.0
    {
        uCHIP,WRITE_EQ,_BAND_,_COEF0_,_COEF1_,_COEF2_,_COEF3_,_COEF4_
    }
}

#Part ABCD EFGH IJKL MNOP

